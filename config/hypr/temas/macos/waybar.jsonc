// Waybar · Tema MACOS: barra de menú arriba + dock abajo
[
    {
        "name": "menubar",
        "layer": "top",
        "position": "top",
        "height": 30,
        "spacing": 2,
        "modules-left": [
            "custom/manzana",
            "hyprland/window"
        ],
        "modules-center": [],
        "modules-right": [
            "tray",
            "custom/minimizadas",
            "hyprland/workspaces",
            "battery",
            "network",
            "bluetooth",
            "pulseaudio",
            "custom/buscar",
            "clock"
        ],
        "custom/manzana": {
            "format": "⌘",
            "tooltip-format": "Menú de sesión",
            "on-click": "bash ~/.config/hypr/scripts/menu-energia.sh"
        },
        "hyprland/window": {
            "format": "{class}",
            "separate-outputs": true,
            "max-length": 30,
            "rewrite": {
                "": "Escritorio",
                "kitty": "Terminal",
                "firefox.*": "Firefox",
                "[Tt]hunar": "Archivos",
                "[Cc]ode.*": "VS Code",
                "google-chrome": "Chrome",
                "brave-browser": "Brave",
                "org\\.gnome\\.Nautilus": "Archivos",
                "pavucontrol": "Sonido",
                "libreoffice-.*": "LibreOffice",
                "Postman": "Postman",
                "jetbrains-(.*)": "JetBrains $1"
            }
        },
        "hyprland/workspaces": {
            "format": "{icon}",
            "format-icons": {
                "active": "",
                "default": "",
                "empty": ""
            },
            "persistent-workspaces": {
                "*": 5
            },
            "show-special": false,
            "on-scroll-up": "hyprctl dispatch workspace e+1",
            "on-scroll-down": "hyprctl dispatch workspace e-1"
        },
        "custom/minimizadas": {
            "exec": "bash ~/.config/hypr/scripts/minimizadas-contador.sh",
            "return-type": "json",
            "interval": 60,
            "signal": 8,
            "on-click": "bash ~/.config/hypr/scripts/restaurar.sh",
            "tooltip": true,
            "on-click-right": "bash ~/.config/hypr/scripts/restaurar.sh --todas",
            "max-length": 40
        },
        "tray": {
            "icon-size": 15,
            "spacing": 10
        },
        "battery": {
            "states": {
                "warning": 25,
                "critical": 12
            },
            "format": "{capacity}% {icon}",
            "format-charging": "{capacity}% ",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ],
            "tooltip-format": "{timeTo}"
        },
        "network": {
            "format-wifi": "",
            "format-ethernet": "",
            "format-disconnected": "",
            "tooltip-format": "{essid} · {ipaddr}",
            "on-click": "bash ~/.config/hypr/scripts/wifi.sh",
            "on-click-right": "bash ~/.config/hypr/scripts/wifi.sh toggle"
        },
        "pulseaudio": {
            "format": "{icon}",
            "format-muted": "",
            "format-icons": {
                "default": [
                    "",
                    "",
                    ""
                ]
            },
            "tooltip-format": "Volumen {volume}%",
            "on-click": "pavucontrol",
            "scroll-step": 5
        },
        "custom/buscar": {
            "format": "",
            "tooltip-format": "Spotlight (Windows + Espacio)",
            "on-click": "pkill wofi || wofi --show drun"
        },
        "clock": {
            "format": "{:%a %d %b  %H:%M}",
            "locale": "es_MX.UTF-8",
            "tooltip-format": "<tt><small>{calendar}</small></tt>",
            "calendar": {
                "mode": "month",
                "format": {
                    "today": "<span background='#0a84ff' color='#ffffff'><b>{}</b></span>"
                }
            }
        },
        "bluetooth": {
            "format": "",
            "format-off": "",
            "format-disabled": "",
            "format-connected": " {num_connections}",
            "tooltip-format": "{controller_alias} · {status}",
            "tooltip-format-connected": "{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}",
            "on-click": "bash ~/.config/hypr/scripts/bluetooth.sh",
            "on-click-right": "bash ~/.config/hypr/scripts/bluetooth.sh toggle"
        }
    },
    {
        "name": "dock",
        "layer": "top",
        "position": "bottom",
        "height": 66,
        "margin-bottom": 8,
        "exclusive": true,
        "modules-center": [
            "custom/launchpad",
            "custom/mission",
            "wlr/taskbar"
        ],
        "custom/launchpad": {
            "format": "",
            "tooltip-format": "Launchpad",
            "on-click": "bash ~/.config/hypr/scripts/menu-apps.sh"
        },
        "wlr/taskbar": {
            "format": "{icon}",
            "icon-size": 44,
            "spacing": 4,
            "tooltip-format": "{title}",
            "on-click": "activate",
            "on-click-middle": "close",
            "on-click-right": "close",
            "ignore-list": [
                "wofi",
                "rofi"
            ],
            "icon-theme": "Papirus-Dark"
        },
        "custom/mission": {
            "format": "",
            "tooltip-format": "Mission Control (Windows + Tab)",
            "on-click": "hyprctl dispatch hyprexpo:expo toggle"
        }
    }
]
