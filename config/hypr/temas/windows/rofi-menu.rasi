/* Menú de apps estilo GNOME · tema windows */
configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "";
    drun-display-format: "{name}";
    font: "Cantarell 12";
    hover-select: true;
    drun-use-desktop-cache: true;
    drun-reload-desktop-cache: false;
    drun-match-fields: "name,generic,exec";
    disable-history: false;
    sort: false;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    acento: #60cdff;
    texto: #ffffff;
    background-color: transparent;
    text-color: @texto;
}

window {
    fullscreen: true;
    background-color: #1c1c1c;
    padding: 70px 12%;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 44px;
}

/* Buscador: píldora centrada arriba */
inputbar {
    children: [ entry ];
    margin: 0 32%;
    padding: 12px 24px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 9%);
    border: 0 0 2px 0;
    border-color: @acento;
}
entry {
    placeholder: "Escribe para buscar";
    placeholder-color: rgba(255, 255, 255, 55%);
    horizontal-align: 0.5;
    cursor-color: @acento;
}

/* Cuadrícula: icono grande con el nombre debajo */
listview {
    columns: 7;
    lines: 4;
    dynamic: false;
    spacing: 18px;
    flow: horizontal;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
}
element {
    orientation: vertical;
    padding: 20px 8px;
    spacing: 14px;
    border-radius: 20px;
}
element selected {
    background-color: rgba(255, 255, 255, 12%);
}
element-icon {
    size: 64px;
    horizontal-align: 0.5;
}
element-text {
    horizontal-align: 0.5;
    text-color: inherit;
}
element selected element-text {
    text-color: @acento;
}
