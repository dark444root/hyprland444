{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": { "top": 1, "left": 2, "right": 3 },
        "color": { "1": "magenta", "2": "cyan" }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "magenta", "title": "cyan" },
        "key": { "width": 6 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
        { "type": "os",       "key": " ", "keyColor": "red" },
        { "type": "kernel",   "key": " ", "keyColor": "magenta" },
        { "type": "wm",       "key": " ", "keyColor": "blue" },
        { "type": "terminal", "key": " ", "keyColor": "cyan" },
        { "type": "uptime",   "key": " ", "keyColor": "green" },
        { "type": "cpu",      "key": " ", "keyColor": "yellow", "showPeCoreCount": false },
        { "type": "memory",   "key": " ", "keyColor": "red" },
        { "type": "disk",     "key": " ", "keyColor": "magenta", "folders": "/" },
        { "type": "battery",  "key": " ", "keyColor": "green" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
    ]
}
