/* Galería de imágenes: cuadrícula de miniaturas grandes */
configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "Inter 11";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}
* {
    acento: #7fb4ff;
    background-color: transparent;
    text-color: #f2f2f5;
}
window {
    width: 1180px;
    height: 780px;
    background-color: rgba(22, 22, 28, 92%);
    border: 1px;
    border-color: rgba(255, 255, 255, 12%);
    border-radius: 24px;
    padding: 22px;
}
mainbox { children: [ inputbar, listview ]; spacing: 18px; }
inputbar {
    children: [ prompt, entry ];
    spacing: 14px;
    padding: 12px 18px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 7%);
}
prompt { text-color: @acento; }
entry { placeholder: "Filtrar por nombre…"; placeholder-color: rgba(255, 255, 255, 45%); }
listview {
    columns: 5;
    lines: 3;
    spacing: 14px;
    flow: horizontal;
    fixed-columns: true;
    fixed-height: true;
    scrollbar: false;
    cycle: false;
}
element {
    orientation: vertical;
    padding: 10px;
    spacing: 8px;
    border-radius: 16px;
}
element selected { background-color: rgba(127, 180, 255, 22%); }
element-icon {
    size: 170px;
    horizontal-align: 0.5;
    border-radius: 12px;
}
element-text {
    horizontal-align: 0.5;
    text-color: inherit;
}
